PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/ustachi
JWT_SECRET=yangi-sirli-soz
CORS_ORIGIN=http://localhost:3000
# MAX_CONNECTIONS_PER_IP — socket.io bitta IP dan maksimal ulanishlar soni (default 10)
MAX_CONNECTIONS_PER_IP=10
# Telegram tasdiqlash boti (foydalanuvchi Start berganda o'z chat'iga kod oladi)
TELEGRAM_BOT_TOKEN=bot-token-ringiz
TELEGRAM_BOT_USERNAME=bot_username_ringiz
# AI video/foto tahlil (Google Gemini — tekin: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tekin-google-ai-apikey
GEMINI_MODEL=gemini-2.5-flash
# Admin paneliga kirish uchun telefon raqamlar (vergul bilan ajrating)
ADMIN_PHONES=+998934735955
# Karta ma'lumotlarini shifrlash (AES-256). 32 baytlik maxfiy so'z.
CARD_SECRET=juda-maxfiy-karta-sirlovi
# To'lov rejimi: sandbox (sinov, real to'lov qilmaydi) | live (real shlyuz bilan)
PAYMENT_MODE=sandbox
# --- Click to'lov (https://docs.click.uz) ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# --- Payme to'lov (https://developer.help.paycom.uz) ---
# PAYME_MERCHANT_KEY = "merchant_id:password" ning password qismi (Basic auth)
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# --- Expo push (kerak bo'lsa) ---
# EXPO_ACCESS_TOKEN=